  "narrative": {
    "northStar": "Supplied Festival Print",
    "overview": "The supplied festival poster kit sets the world: neutral paper, dense dark ink, amber fields, coral registration, grain and halftone. Condensed headlines carry the invitation; rounded game surfaces keep the controls approachable. The source rocket, planet, stars and year stamp retain the event’s drawn and printed character.\n\nThe shared shell gives original institutional identities quiet space above and below the games. Festival is the default composition; Lobby and Classic are valid expressions of the same palette, typography, controls and source artwork. Turkish and English use the same hierarchy and complete identity strips. Color Cascade is a source-preserved exception inside its original iframe: its native colors, font, hearts, effects, controls and internal English text remain unchanged; the surrounding station retains this festival system and bilingual instructions.",
    "keyCharacteristics": [
      "Printed source material with neutral paper and dark ink.",
      "Condensed headlines paired with readable Bricolage instructions.",
      "Rounded game surfaces, visible controls and direct amber actions.",
      "Static original identities and restrained, purposeful motion."
    ],
    "rules": [
      {
        "name": "The Original Identity Rule",
        "body": "Use complete supplied identity artwork at its original proportions, with quiet clearspace; keep logos static and free of effects.",
        "section": "colors"
      },
      {
        "name": "The Role Separation Rule",
        "body": "Use Big Shoulders Display for station headlines, Bricolage for station instructions and controls, and Courier Prime for actual case timestamps. The Georgia club name is confined to the identity area. The original Color Cascade iframe retains its source typography.",
        "section": "typography"
      },
      {
        "name": "The Printed Depth Rule",
        "body": "Use borders, source texture and tonal layering for depth. The coral registration on festival display text belongs to the poster; it is not a general container shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the final paper token for shared page backgrounds.",
      "Do preserve original event illustrations, grain, halftone and complete institutional artwork.",
      "Do keep both language states legible and use the corresponding supplied organizer strip.",
      "Do show the control hint beside each game and keep the primary action broad.",
      "Do honor reduced motion and pause home animation when hidden or offscreen.",
      "Do keep the laptop menu in the first viewport and the intact institutional footer below the fold.",
      "Do preserve Color Cascade’s original source and presentation inside its iframe; apply station styling and bilingual instructions around it."
    ],
    "donts": [
      "Don't redraw, distort, recolor, rotate or animate institutional identities.",
      "Don't carry the rejected neon command-center or sci-fi HUD treatment into new surfaces.",
      "Don't turn poster registration into hard offset shadows on controls or containers.",
      "Don't run repeating game demonstrations across the menu; demonstrations are one-shot responses to hover or keyboard focus.",
      "Don't add numeric labels, lane keys, pause controls or a replacement engine to the original Color Cascade."
    ]
  }
}
